# Runtime test executor deployment profile.
# Safe default: disabled. Staging is intentionally inert.
ARENA_RUNTIME_DEPLOYMENT=disabled

# For isolated staging configuration only:
# ARENA_RUNTIME_DEPLOYMENT=staging

# Production values are deliberately commented out. Do not enable until the
# supervisor socket, root-owned worker bundle, artifact handoff, network bridge,
# systemd effective-property checks and crash recovery have passed review.
# ARENA_RUNTIME_DEPLOYMENT=production
# ARENA_RUNTIME_PRODUCTION_ACK=I_UNDERSTAND_RUNTIME_EXECUTION
# ARENA_RUNTIME_BACKEND=systemd
# ARENA_RUNTIME_EXECUTION_ENABLED=1
# ARENA_RUNTIME_SUPERVISOR_SOCKET=/run/ai-chess-arena-runtime/supervisor.sock
# ARENA_RUNTIME_ARTIFACT_ROOT=/var/lib/arena-handoff
# ARENA_RUNTIME_OUTPUT_ROOT=/run/arena-runtime
# ARENA_RUNTIME_WORKER_BUNDLE=/usr/local/lib/ai-chess-arena-runtime
