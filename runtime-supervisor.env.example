# Example only. Do not install or enable until Issue #157 production gates pass.
ARENA_RUNTIME_DEPLOYMENT=production
ARENA_RUNTIME_PRODUCTION_ACK=I_UNDERSTAND_RUNTIME_EXECUTION
ARENA_RUNTIME_BACKEND=systemd
ARENA_RUNTIME_EXECUTION_ENABLED=1

# Must point to the exact same canonical database used by server.py.
ARENA_RUNTIME_DATABASE=/home/debian/ai-chess-arena/arena.sqlite3
ARENA_RUNTIME_SUPERVISOR_BUNDLE=/usr/local/lib/ai-chess-arena-runtime/runtime_supervisor.pyz
# Pin the exact reviewed zipapp bytes; never leave the placeholder in production.
ARENA_RUNTIME_SUPERVISOR_BUNDLE_SHA256=REPLACE_WITH_REVIEWED_BUNDLE_SHA256
ARENA_RUNTIME_SUPERVISOR_SOCKET=/run/ai-chess-arena-runtime/supervisor.sock
ARENA_RUNTIME_LEASE_BROKER_SOCKET=/run/ai-chess-arena-api/lease-broker.sock
ARENA_RUNTIME_QUARANTINE_ROOT=/var/lib/ai-chess-arena/hf-candidate-downloads
ARENA_RUNTIME_ARTIFACT_ROOT=/var/lib/arena-handoff
ARENA_RUNTIME_OUTPUT_ROOT=/run/arena-runtime
ARENA_RUNTIME_WORKER_PATH=/usr/local/lib/ai-chess-arena-runtime/runtime_worker
ARENA_RUNTIME_WORKER_SHA256=REPLACE_WITH_REVIEWED_64_CHAR_SHA256

# Exact artifact keys: repo|40-char-commit|filename.gguf
# Keep empty until each artifact is explicitly reviewed and authorized.
ARENA_RUNTIME_ARTIFACT_ALLOWLIST=REPLACE_WITH_EXACT_REVIEWED_ARTIFACT_KEY
ARENA_RUNTIME_REVIEW_REQUIRED_ARTIFACTS=

ARENA_RUNTIME_API_USER=debian
ARENA_RUNTIME_API_GROUP=debian
ARENA_RUNTIME_USER=arena-runtime
ARENA_RUNTIME_GROUP=arena-runtime
