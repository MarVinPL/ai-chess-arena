# Persistent AI Chess Arena API process settings.
# Copy to /etc/ai-chess-arena/runtime-process.env for the systemd service.
# The defaults below preserve the existing API behavior; runtime execution
# remains disabled unless its separate deployment gates are explicitly met.
ARENA_DATABASE_PATH=/home/debian/ai-chess-arena/arena.sqlite3
ARENA_LOG_DIR=/home/debian/ai-chess-arena/logs
ARENA_HTTP_HOST=127.0.0.1
ARENA_HTTP_PORT=8090
ARENA_BACKGROUND_JOBS=1
ARENA_RUNTIME_DEPLOYMENT=disabled

# Example: isolated local integration process (do not use the production DB).
# Use a private disposable directory and a separate process, not the live unit.
# ARENA_DATABASE_PATH=/tmp/arena-api-integration/arena.sqlite3
# ARENA_LOG_DIR=/tmp/arena-api-integration/logs
# ARENA_HTTP_HOST=127.0.0.1
# ARENA_HTTP_PORT=0
# ARENA_BACKGROUND_JOBS=0
# ARENA_RUNTIME_DEPLOYMENT=disabled
